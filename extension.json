{
  "name": "valvrare-team",
  "displayName": "Valvrare Team",
  "publisher": "valvrare",
  "version": "0.1.0",
  "description": "Tìm kiếm và đọc truyện từ Valvrare Team.",
  "starter": {
    "kind": "scraper"
  },
  "engines": {
    "enovel": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "browser": "./dist/browser.js",
  "icon": "./public/icon.png",
  "activationEvents": [
    "always"
  ],
  "categories": [
    "Scrapers"
  ],
  "keywords": [
    "e-novels",
    "scraper",
    "valvrare",
    "typescript"
  ],
  "permissions": [
    "network",
    "reader",
    "storage"
  ],
  "network": {
    "allowedHosts": [
      "valvrareteam.net",
      "cdn.valvrareteam.net",
      "valvrareteam.b-cdn.net",
      "images.weserv.nl"
    ]
  },
  "contributes": {
    "settings": {
      "fields": [
        {
          "id": "username",
          "type": "text",
          "label": "Tài khoản Valvrare Team",
          "placeholder": "Nhập tên tài khoản"
        },
        {
          "id": "password",
          "type": "password",
          "label": "Mật khẩu Valvrare Team",
          "placeholder": "••••••••"
        }
      ],
      "actions": [
        {
          "id": "loginAndCheckConnection",
          "label": "Đăng nhập & Kiểm tra kết nối",
          "fields": [
            "username",
            "password"
          ],
          "style": "primary"
        },
        {
          "id": "checkConnectionAction",
          "label": "Kiểm tra đăng nhập",
          "style": "default"
        },
        {
          "id": "clearSession",
          "label": "Đăng xuất & Xóa Session"
        }
      ]
    },
    "scraper": {
      "name": "Valvrare Team",
      "description": "Tìm kiếm và đọc truyện từ Valvrare Team.",
      "version": 2,
      "site": {
        "name": "Valvrare Team",
        "baseUrl": "https://valvrareteam.net"
      },
      "capabilities": [
        "search",
        "getBookDetail",
        "getChapter",
        "download",
        "getFilterOptions"
      ],
      "search": {
        "pageSize": 20,
        "fields": [
          {
            "id": "query",
            "type": "text",
            "label": "Tìm kiếm truyện..."
          },
          {
            "id": "status",
            "type": "select",
            "label": "Tình trạng",
            "defaultValue": "any",
            "options": [
              {
                "label": "Tất cả",
                "value": "any"
              },
              {
                "label": "Đang tiến hành",
                "value": "Ongoing"
              },
              {
                "label": "Hoàn thành",
                "value": "Completed"
              },
              {
                "label": "Tạm ngưng",
                "value": "Hiatus"
              }
            ]
          }
        ]
      }
    }
  }
}